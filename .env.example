# ==============================================================================
# PocketLens Environment Configuration Template
# ==============================================================================

# Application
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# Database (PostgreSQL 16)
POSTGRES_DB=pocketlens
POSTGRES_USER=pocketlens
POSTGRES_PASSWORD=pocketlens_dev_password
DATABASE_URL=postgresql://pocketlens:pocketlens_dev_password@postgres:5432/pocketlens?schema=public
# Host-level connection URL (for running tests/CLI outside Docker):
# DATABASE_URL=postgresql://pocketlens:pocketlens_dev_password@localhost:5432/pocketlens?schema=public

# Redis (Redis 7 Alpine)
REDIS_URL=redis://redis:6379
# Host-level connection URL (for running tests/CLI outside Docker):
# REDIS_URL=redis://localhost:6379

# Authentication & Session Security
COOKIE_SECRET=pocketlens_dev_secret_cookie_key_32_chars_long
SESSION_EXPIRY_DAYS=30

# Receipt Storage (Local Volume or S3-compatible)
STORAGE_PROVIDER=local
RECEIPT_STORAGE_PATH=/data/receipts
MAX_RECEIPT_FILE_SIZE=10485760

# Background Worker & BullMQ OCR Processing
RECEIPT_QUEUE_NAME=receipt-processing
RECEIPT_WORKER_CONCURRENCY=2

# Recurring Transaction Scheduler
RECURRING_SCHEDULER_INTERVAL_MS=60000

# Multi-Currency & FX Reporting
DEFAULT_REPORTING_CURRENCY=VND

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
