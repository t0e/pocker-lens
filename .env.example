# Node Environment
NODE_ENV=development

# Service Ports (host-facing)
WEB_PORT=3000
API_PORT=4000

# PostgreSQL Configuration
POSTGRES_DB=pocketlens
POSTGRES_USER=pocketlens
POSTGRES_PASSWORD=pocketlens_dev_password
# Internal connection string for Docker containers:
DATABASE_URL=postgresql://pocketlens:pocketlens_dev_password@postgres:5432/pocketlens?schema=public
# Host connection string (for local CLI running outside Docker if needed):
# DATABASE_URL=postgresql://pocketlens:pocketlens_dev_password@localhost:5432/pocketlens?schema=public

# Redis Configuration
# Internal connection URL for Docker containers:
REDIS_URL=redis://redis:6379
# Host connection URL (for local CLI running outside Docker if needed):
# REDIS_URL=redis://localhost:6379

# Authentication & Session
COOKIE_SECRET=pocketlens_dev_secret_cookie_key_32_chars_long
SESSION_EXPIRY_DAYS=30

# Storage Configuration (Local volume mounted at /data/receipts)
STORAGE_PROVIDER=local
RECEIPT_STORAGE_PATH=/data/receipts
MAX_RECEIPT_FILE_SIZE=10485760

# Background Worker & BullMQ Queue Configuration
RECEIPT_QUEUE_NAME=receipt-processing
RECEIPT_WORKER_CONCURRENCY=2
