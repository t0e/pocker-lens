datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Phase 1: Foundation baseline table
model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_system_metadata")
}

// Phase 2: Users
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName       String        @map("display_name")
  reportingCurrency String        @default("VND") @db.VarChar(3) @map("reporting_currency")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  accounts              Account[]
  sessions              Session[]
  categories            Category[]
  transactions          Transaction[]
  receipts              Receipt[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@map("users")
}

// Phase 2: Persistent Server-Side Sessions
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

enum AccountType {
  CASH        @map("cash")
  BANK        @map("bank")
  CREDIT_CARD @map("credit_card")
  SAVINGS     @map("savings")
  E_WALLET    @map("e_wallet")
  OTHER       @map("other")
}

// Phase 2: Financial Accounts
model Account {
  id                    String                 @id @default(cuid())
  userId                String                 @map("user_id")
  name                  String
  type                  AccountType
  currency              String                 @db.VarChar(3)
  openingBalance        Decimal                @default(0) @db.Decimal(19, 4) @map("opening_balance")
  currentBalance        Decimal                @default(0) @db.Decimal(19, 4) @map("current_balance")
  isArchived            Boolean                @default(false) @map("is_archived")
  isDefault             Boolean                @default(false) @map("is_default")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]          @relation("AccountTransactions")
  transferTransactions  Transaction[]          @relation("TransferTransactions")
  extractions           ReceiptExtraction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@index([userId, isArchived])
  @@map("accounts")
}

enum CategoryType {
  EXPENSE @map("expense")
  INCOME  @map("income")
}

// Phase 3: Categories (System defaults + user custom categories)
model Category {
  id                    String                 @id @default(cuid())
  userId                String?                @map("user_id")
  name                  String
  type                  CategoryType
  icon                  String?
  isSystem              Boolean                @default(false) @map("is_system")
  isArchived            Boolean                @default(false) @map("is_archived")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  extractions           ReceiptExtraction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

enum TransactionType {
  EXPENSE  @map("expense")
  INCOME   @map("income")
  TRANSFER @map("transfer")
}

// Phase 3: Financial Transactions
model Transaction {
  id                     String                @id @default(cuid())
  userId                 String                @map("user_id")
  type                   TransactionType
  accountId              String                @map("account_id")
  transferAccountId      String?               @map("transfer_account_id")
  categoryId             String?               @map("category_id")
  recurringTransactionId String?               @map("recurring_transaction_id")
  amount                 Decimal               @db.Decimal(19, 4)
  currency               String                @db.VarChar(3)
  transactionDate        DateTime              @map("transaction_date")
  description            String
  merchant               String?
  notes                  String?
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                Account               @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount        Account?              @relation("TransferTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category               Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  receipts               Receipt[]
  occurrences            RecurringOccurrence[]

  @@index([userId])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([recurringTransactionId])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@index([userId, type, transactionDate])
  @@index([userId, currency, transactionDate])
  @@index([userId, categoryId, transactionDate])
  @@index([userId, merchant])
  @@map("transactions")
}

enum ReceiptStatus {
  UPLOADED   @map("uploaded")
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")
}

// Phase 5: Receipt Storage & Background Processing Lifecycle
model Receipt {
  id                    String             @id @default(cuid())
  userId                String             @map("user_id")
  originalFilename      String             @map("original_filename")
  storageKey            String             @unique @map("storage_key")
  mimeType              String             @map("mime_type")
  fileSize              Int                @map("file_size")
  status                ReceiptStatus      @default(UPLOADED)
  errorCode             String?            @map("error_code")
  errorMessage          String?            @map("error_message")
  transactionId         String?            @map("transaction_id")
  processingStartedAt   DateTime?          @map("processing_started_at")
  processingCompletedAt DateTime?          @map("processing_completed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction           Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  extraction            ReceiptExtraction?

  @@index([userId])
  @@index([userId, status])
  @@index([transactionId])
  @@map("receipts")
}

// Phase 6: Receipt Multilingual OCR Extraction & Line Items
model ReceiptExtraction {
  id               String        @id @default(cuid())
  receiptId        String        @unique @map("receipt_id")
  merchant         String?
  transactionDate  DateTime?     @map("transaction_date")
  totalAmount      Decimal?      @db.Decimal(19, 4) @map("total_amount")
  currency         String?       @db.VarChar(3)
  categoryId       String?       @map("category_id")
  accountId        String?       @map("account_id")
  rawText          String        @db.Text @map("raw_text")
  detectedLanguage String?       @map("detected_language")
  confidence       Decimal?      @db.Decimal(5, 2)
  fieldConfidences Json?         @map("field_confidences")
  status           String        @default("PENDING_REVIEW")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  receipt          Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account          Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  items            ReceiptItem[]

  @@index([receiptId])
  @@map("receipt_extractions")
}

model ReceiptItem {
  id           String            @id @default(cuid())
  extractionId String            @map("extraction_id")
  description  String
  quantity     Decimal?          @db.Decimal(10, 2)
  unitPrice    Decimal?          @db.Decimal(19, 4) @map("unit_price")
  totalPrice   Decimal?          @db.Decimal(19, 4) @map("total_price")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  extraction   ReceiptExtraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  @@index([extractionId])
  @@map("receipt_items")
}

// Phase 7: Monthly Category Budgets
model Budget {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  amount     Decimal  @db.Decimal(19, 4)
  currency   String   @db.VarChar(3)
  month      String   @db.VarChar(7) // Format: "YYYY-MM" (e.g. "2026-08")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, currency, month])
  @@index([userId])
  @@index([userId, month])
  @@index([categoryId])
  @@map("budgets")
}

enum RecurrenceFrequency {
  DAILY   @map("daily")
  WEEKLY  @map("weekly")
  MONTHLY @map("monthly")
  YEARLY  @map("yearly")
}

// Phase 7: Recurring Transactions & Subscriptions
model RecurringTransaction {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  type           TransactionType      @default(EXPENSE)
  accountId      String               @map("account_id")
  categoryId     String?              @map("category_id")
  amount         Decimal              @db.Decimal(19, 4)
  currency       String               @db.VarChar(3)
  description    String
  frequency      RecurrenceFrequency  @default(MONTHLY)
  interval       Int                  @default(1)
  startDate      DateTime             @map("start_date")
  nextRunDate    DateTime             @map("next_run_date")
  endDate        DateTime?            @map("end_date")
  isActive       Boolean              @default(true) @map("is_active")
  isSubscription Boolean              @default(false) @map("is_subscription")
  merchant       String?
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  occurrences    RecurringOccurrence[]

  @@index([userId])
  @@index([userId, isActive])
  @@index([nextRunDate, isActive])
  @@map("recurring_transactions")
}

// Phase 7: Durable Idempotent Tracking for Generated Recurring Occurrences
model RecurringOccurrence {
  id                     String               @id @default(cuid())
  recurringTransactionId String               @map("recurring_transaction_id")
  transactionId          String?              @map("transaction_id")
  scheduledFor           DateTime             @map("scheduled_for")
  status                 String               @default("GENERATED")
  createdAt              DateTime             @default(now()) @map("created_at")

  recurringTransaction   RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  transaction            Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([recurringTransactionId, scheduledFor])
  @@index([recurringTransactionId])
  @@index([transactionId])
  @@map("recurring_occurrences")
}

// Phase 9: Multi-Currency Exchange Rates
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @db.VarChar(3) @map("base_currency")
  quoteCurrency String   @db.VarChar(3) @map("quote_currency")
  rate          Decimal  @db.Decimal(18, 8)
  rateDate      DateTime @db.Date @map("rate_date")
  provider      String   @default("default")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, quoteCurrency, rateDate, provider])
  @@index([baseCurrency, quoteCurrency, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}
