datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Phase 1: Foundation baseline table
model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_system_metadata")
}

// Phase 2: Users
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  displayName  String        @map("display_name")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  categories   Category[]
  transactions Transaction[]
  receipts     Receipt[]

  @@map("users")
}

// Phase 2: Persistent Server-Side Sessions
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

enum AccountType {
  CASH        @map("cash")
  BANK        @map("bank")
  CREDIT_CARD @map("credit_card")
  SAVINGS     @map("savings")
  E_WALLET    @map("e_wallet")
  OTHER       @map("other")
}

// Phase 2: Financial Accounts
model Account {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  name                 String
  type                 AccountType
  currency             String        @db.VarChar(3)
  openingBalance       Decimal       @default(0) @db.Decimal(19, 4) @map("opening_balance")
  currentBalance       Decimal       @default(0) @db.Decimal(19, 4) @map("current_balance")
  isArchived           Boolean       @default(false) @map("is_archived")
  isDefault            Boolean       @default(false) @map("is_default")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[] @relation("AccountTransactions")
  transferTransactions Transaction[] @relation("TransferTransactions")

  @@index([userId])
  @@index([userId, isArchived])
  @@map("accounts")
}

enum CategoryType {
  EXPENSE @map("expense")
  INCOME  @map("income")
}

// Phase 3: Categories (System defaults + user custom categories)
model Category {
  id           String        @id @default(cuid())
  userId       String?       @map("user_id")
  name         String
  type         CategoryType
  icon         String?
  isSystem     Boolean       @default(false) @map("is_system")
  isArchived   Boolean       @default(false) @map("is_archived")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([type])
  @@map("categories")
}

enum TransactionType {
  EXPENSE  @map("expense")
  INCOME   @map("income")
  TRANSFER @map("transfer")
}

// Phase 3: Financial Transactions
model Transaction {
  id                String          @id @default(cuid())
  userId            String          @map("user_id")
  type              TransactionType
  accountId         String          @map("account_id")
  transferAccountId String?         @map("transfer_account_id")
  categoryId        String?         @map("category_id")
  amount            Decimal         @db.Decimal(19, 4)
  currency          String          @db.VarChar(3)
  transactionDate   DateTime        @map("transaction_date")
  description       String
  merchant          String?
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount   Account?        @relation("TransferTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receipts          Receipt[]

  @@index([userId])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([categoryId])
  @@index([transactionDate])
  @@index([userId, transactionDate])
  @@map("transactions")
}

enum ReceiptStatus {
  UPLOADED   @map("uploaded")
  QUEUED     @map("queued")
  PROCESSING @map("processing")
  READY      @map("ready")
  FAILED     @map("failed")
}

// Phase 5: Receipt Storage & Background Processing Lifecycle
model Receipt {
  id                    String        @id @default(cuid())
  userId                String        @map("user_id")
  originalFilename      String        @map("original_filename")
  storageKey            String        @unique @map("storage_key")
  mimeType              String        @map("mime_type")
  fileSize              Int           @map("file_size")
  status                ReceiptStatus @default(UPLOADED)
  errorCode             String?       @map("error_code")
  errorMessage          String?       @map("error_message")
  transactionId         String?       @map("transaction_id")
  processingStartedAt   DateTime?     @map("processing_started_at")
  processingCompletedAt DateTime?     @map("processing_completed_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction           Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([transactionId])
  @@map("receipts")
}
