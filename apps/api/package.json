{
  "name": "@pocketlens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "type-check": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "test": "vitest run",
    "lint": "echo \"@pocketlens/api lint ok\"",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.5.0",
    "@pocketlens/shared": "*",
    "@prisma/client": "^5.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "ioredis": "^5.4.1",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
