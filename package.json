{
  "name": "pocketlens-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "type-check": "npm run type-check --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "dev": "echo \"Use 'docker compose up' for local development\""
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0"
  }
}
